index 45c0ad6..fef9c87 100644
--- a/core/hw/holly/sb.cpp
+++ b/core/hw/holly/sb.cpp
@@ -663,6 +663,8 @@ void sb_Reset(bool hard)
 		SB_SBREV = 0xB;
 		SB_G2ID = 0x12;
 		SB_G1SYSM = ((0 << 4) | 1);
